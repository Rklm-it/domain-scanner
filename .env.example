# Comments must be on their own line, never after a value: Docker Compose does
# not strip trailing comments when it reads env_file.

# ---------------------------------------------------------------- web server

# Access token for the web UI and API. LEAVE THIS EMPTY ONLY FOR LOCAL USE --
# an instance on a public IP without a token is an open scanning proxy.
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SCANNER_TOKEN=

# Set to 1 when running behind nginx/Caddy/Cloudflare so per-client rate
# limiting reads X-Forwarded-For instead of seeing every request as 127.0.0.1.
# Leave 0 when the app is directly exposed -- the header is spoofable.
SCANNER_TRUST_PROXY=0

# Host port published on 127.0.0.1. Change if 8000 is taken by another service
# on this machine. Ignored when a reverse proxy reaches the container over a
# shared Docker network instead of the host.
SCANNER_PORT=8000

SCANNER_DB=data/scanner.db

# Scans allowed per client, per SCANNER_RATE_WINDOW seconds.
SCANNER_RATE_LIMIT=20
SCANNER_RATE_WINDOW=3600

# Domains accepted in a single scan.
MAX_DOMAINS_PER_SCAN=50

# Scans running at once. Anything submitted beyond this waits in a queue.
SCANNER_MAX_CONCURRENT_SCANS=4

# Domains scanned in parallel within one scan.
SCANNER_WORKERS=8

SCANNER_HTTP_TIMEOUT=12

# --- deadlines: what stops one bad domain from hanging the whole tool -------
# Checks run one after another inside a domain and each talks to a different
# third party. SCANNER_DOMAIN_BUDGET is the time a domain gets for the lot of
# them: once it is spent the remaining checks are skipped and marked as such,
# so the domain returns partial results instead of stalling the scan.
SCANNER_DOMAIN_BUDGET=120

# The budget can only be checked between checks -- it cannot interrupt a socket
# read. This is the hard ceiling enforced from outside: past it the domain is
# recorded as timed out and the scan moves on.
SCANNER_DOMAIN_TIMEOUT=240

# Absolute cap on one batch, whatever its size.
SCANNER_SCAN_TIMEOUT=1800

# Connectivity self-test. Set to 0 if your egress blocks the control hosts
# (www.google.com, one.one.one.one) but real scanning works.
SCANNER_PREFLIGHT=1
SCANNER_PREFLIGHT_INTERVAL=300

# Resolver for DNS and blocklist checks, comma-separated. Spamhaus/SURBL/URIBL
# refuse queries from public resolvers (8.8.8.8, 1.1.1.1), and most cloud hosts
# forward to exactly those by default -- including through Docker's internal
# resolver at 127.0.0.11. Point this at a resolver that does its own recursion
# (a local unbound, for instance) to reach the free public zones.
#
# The alternative, and the easier one on a cloud host, is a subscriber key
# below: the query then goes to the provider's own service, which answers
# regardless of which resolver you use.
SCANNER_NAMESERVER=

# ------------------------------------------------------------------ api keys
# All optional. A check without its key is skipped, not failed, and does not
# count against a scan's confidence score.

# Google Safe Browsing v4 -- the only source here that is literally Google's
# own opinion of the domain. Free.
# https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal -- ~90 vendor verdicts + categories. Free tier: 4 requests/minute.
# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Spamhaus DQS -- free tier, and the supported way to query Spamhaus from a
# cloud host. Without it Spamhaus (the most useful list here) is simply not
# consulted, and the scan says so rather than pretending the domain is clean.
# https://www.spamhaus.com/free-trial/
SPAMHAUS_DQS_KEY=

# URIBL subscriber key. Same idea; the free public zone is rate limited and
# refuses public resolvers.
# https://uribl.com/about.shtml
URIBL_KEY=

# Optional outbound proxy for the HTTP checks (see a lander from a given geo).
SCANNER_PROXY=
