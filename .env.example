# ---------------------------------------------------------------- web server
# Access token for the web UI and API. LEAVE THIS EMPTY ONLY FOR LOCAL USE --
# an instance on a public IP without a token is an open scanning proxy.
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SCANNER_TOKEN=

# Set to 1 when running behind nginx/Caddy/Cloudflare so per-client rate
# limiting reads X-Forwarded-For instead of seeing every request as 127.0.0.1.
# Leave 0 when the app is directly exposed -- the header is spoofable.
SCANNER_TRUST_PROXY=0

# Host port the container publishes on 127.0.0.1. Change if 8000 is taken by
# another service on this machine; must match the nginx upstream.
SCANNER_PORT=8000

SCANNER_DB=data/scanner.db
SCANNER_RATE_LIMIT=20          # scans allowed per client...
SCANNER_RATE_WINDOW=3600       # ...per this many seconds
MAX_DOMAINS_PER_SCAN=50
SCANNER_MAX_CONCURRENT_SCANS=2 # scans running at once
SCANNER_WORKERS=8              # domains in parallel within one scan
SCANNER_HTTP_TIMEOUT=12

# Connectivity self-test. Set to 0 if your egress blocks the control hosts
# (www.google.com, one.one.one.one) but real scanning works.
SCANNER_PREFLIGHT=1
SCANNER_PREFLIGHT_INTERVAL=300

# Resolver for DNS and blocklist checks. Spamhaus/SURBL/URIBL refuse queries
# from public resolvers (8.8.8.8, 1.1.1.1), so a resolver that will answer for
# you -- your provider's, or a local unbound -- makes those checks meaningful.
# Comma-separated.
SCANNER_NAMESERVER=

# ------------------------------------------------------------------ api keys
# All optional. A check without its key is skipped, not failed, and does not
# count against a scan's confidence score.

# Google Safe Browsing v4 -- the only source here that is literally Google's
# own opinion of the domain. Free.
# https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal -- ~90 vendor verdicts + categories. Free tier: 4 requests/minute.
# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Optional outbound proxy for the HTTP checks (see a lander from a given geo).
SCANNER_PROXY=
